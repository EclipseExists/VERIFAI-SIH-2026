# VERIFAI Backend — Environment Variables
# ==========================================
# Copy this file to .env and modify the values.
# The .env file is gitignored (never committed to source control).
#
# HOW TO USE:
#   cp .env.example .env
#   # Edit .env with your local values
#
# The backend reads these via pydantic-settings (app/core/config.py).

# ── Database Connection ───────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# For Docker Compose: use 'postgres' as host (the service name)
# For local PostgreSQL: use 'localhost'
DATABASE_URL=postgresql+asyncpg://verifai:verifai_dev@localhost:5432/verifai_db

# ── JWT Secret Key ────────────────────────────────────────────────
# Used to sign authentication tokens.
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use this default value in production!
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── File Storage ──────────────────────────────────────────────────
# Directory where uploaded document images are saved.
# Relative to the backend/ directory.
UPLOAD_DIR=uploads

